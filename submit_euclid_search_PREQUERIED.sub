
shell = ./euclid_search.sh $(NSIDE) $(PIX)

log = job_logs/test_$(Cluster)_$(Process).log
error = job_logs/test_$(Cluster)_$(Process).err
output = job_logs/test_$(Cluster)_$(Process).out

# +IsBuildJob = True

transfer_input_files = euclid_search.sh, ufd_alfred.tar.gz, osdf:///chtc/staging/k/kexcell/euclid_dr1/$(NSIDE)_$(PIX)_euclid.parquet
transfer_output_remaps = "output.tar.gz = /home/kexcell/outputs/output_$(Cluster)_$(NewProcess).tar.gz; $(NSIDE)_$(PIX)_euclid.parquet = osdf:///chtc/staging/k/kexcell/euclid_dr1/$(NSIDE)_$(PIX)_euclid.parquet"
container_image = dwarf_search_container.sif

request_cpus = 1
request_memory = 5GB
request_disk = 5GB

# which jobs to run
queue NSIDE, PIX from prequeried_euclid_dr1_ring_pixels.txt
