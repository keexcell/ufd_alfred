Bootstrap: docker
From: python:3.12

%files
    ugali.tar.gz ugali.tar.gz

%post

# installing necessary packages
    #apt-get update -y --allow-insecure-repositories
    apt-get install python3.12-venv -y --allow-unauthenticated
    alias python=python3.12
    python -m venv env --upgrade-deps
    . env/bin/activate
    
    python3 -m pip install --upgrade pip
    python3 -m pip install numpy==2.3.5 pandas==3.0.3 scipy==1.17.1 matplotlib==3.10.9 astropy==7.2.0 astropy_healpix==1.1.3 astroquery==0.4.11 healpy==1.19.0 healsparse==1.12.2 seaborn==0.13.2 pyvo==1.9.1
    python3 -m pip install pyarrow fastparquet pyyaml emcee nose fitsio corner setuptools six
    
